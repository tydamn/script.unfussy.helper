<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <defaultcontrol always="true">101</defaultcontrol>
    <animation effect="fade" end="100" time="250">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>

    <controls>
        <include>background_dialog</include>

        <!-- main panel -->
        <control type="group">
            <left>100</left>
            <top>100</top>
            <width>1720</width>
            <height>880</height>

            <control type="image">
                <width>1720</width>
                <height>880</height>
                <aspectratio>stretch</aspectratio>
                <texture colordiffuse="black">colors/white.png</texture>
                <bordertexture colordiffuse="border">colors/white.png</bordertexture>
                <bordersize>1</bordersize>
            </control>

            <!-- poster / EPG image - no background frame -->
            <control type="group">
                <visible>!String.IsEmpty(Window.Property(epgeventicon)) | !String.IsEmpty(Window.Property(thumbnail))</visible>
                <left>30</left>
                <top>35</top>
                <width>420</width>
                <height>690</height>

                <control type="image">
                    <visible>!String.IsEmpty(Window.Property(epgeventicon))</visible>
                    <width>420</width>
                    <height>690</height>
                    <aspectratio align="center" aligny="center">keep</aspectratio>
                    <texture>$INFO[Window.Property(epgeventicon)]</texture>
                </control>

                <control type="image">
                    <visible>String.IsEmpty(Window.Property(epgeventicon)) + !String.IsEmpty(Window.Property(thumbnail))</visible>
                    <width>420</width>
                    <height>690</height>
                    <aspectratio align="center" aligny="center">keep</aspectratio>
                    <texture>$INFO[Window.Property(thumbnail)]</texture>
                </control>
            </control>

            <!-- fallback channel box when no EPG/poster image exists -->
            <control type="group">
                <visible>String.IsEmpty(Window.Property(epgeventicon)) + String.IsEmpty(Window.Property(thumbnail))</visible>
                <left>30</left>
                <top>35</top>
                <width>420</width>
                <height>300</height>

                <control type="image">
                    <width>420</width>
                    <height>300</height>
                    <aspectratio>stretch</aspectratio>
                    <texture colordiffuse="33000000">colors/white.png</texture>
                    <bordertexture colordiffuse="border">colors/white.png</bordertexture>
                    <bordersize>1</bordersize>
                </control>

                <control type="image">
                    <visible>!String.IsEmpty(Window.Property(channelicon))</visible>
                    <left>35</left>
                    <top>30</top>
                    <width>350</width>
                    <height>220</height>
                    <aspectratio>keep</aspectratio>
                    <texture>$INFO[Window.Property(channelicon)]</texture>
                </control>

                <control type="textbox">
                    <visible>String.IsEmpty(Window.Property(channelicon))</visible>
                    <left>25</left>
                    <top>30</top>
                    <width>370</width>
                    <height>220</height>
                    <align>center</align>
                    <aligny>center</aligny>
                    <font>light50</font>
                    <textcolor>active</textcolor>
                    <shadowcolor>black</shadowcolor>
                    <label>$INFO[Window.Property(channel)]</label>
                </control>
            </control>

            <!-- time info under poster / fallback image -->
            <control type="label">
                <visible>!String.IsEmpty(Window.Property(timingtime))</visible>
                <left>30</left>
                <top>725</top>
                <width>420</width>
                <height>38</height>
                <font>regular30</font>
                <align>center</align>
                <aligny>center</aligny>
                <textcolor>white</textcolor>
                <shadowcolor>black</shadowcolor>
                <label>[COLOR active]$INFO[Window.Property(timinglabel)][/COLOR]   $INFO[Window.Property(timingtime)]</label>
            </control>

            <!-- content area inspired by wide media-info layout -->
            <control type="group">
                <left>500</left>
                <top>35</top>
                <width>1185</width>
                <height>760</height>

                <!-- title / subtitle -->
                <control type="label">
                    <top>18</top>
                    <left>0</left>
                    <width>970</width>
                    <height>76</height>
                    <font>light70</font>
                    <textcolor>active</textcolor>
                    <scroll>true</scroll>
                    <label>$INFO[Window.Property(title)]</label>
                    <aligny>center</aligny>
                </control>

                <control type="label">
                    <visible>!String.IsEmpty(Window.Property(episodename))</visible>
                    <top>92</top>
                    <left>2</left>
                    <width>970</width>
                    <height>38</height>
                    <font>light36</font>
                    <textcolor>white</textcolor>
                    <scroll>true</scroll>
                    <label>$INFO[Window.Property(episodename)]</label>
                    <aligny>center</aligny>
                </control>

                <control type="label">
                    <visible>!String.IsEmpty(Window.Property(runtime))</visible>
                    <top>106</top>
                    <left>2</left>
                    <width>970</width>
                    <height>34</height>
                    <font>regular30</font>
                    <textcolor>white</textcolor>
                    <label>[COLOR active]$LOCALIZE[2050][/COLOR]  $INFO[Window.Property(runtime)] min</label>
                    <aligny>center</aligny>
                </control>

                <!-- channel logo in header -->
                <control type="image">
                    <visible>!String.IsEmpty(Window.Property(channelicon))</visible>
                    <top>0</top>
                    <right>0</right>
                    <width>190</width>
                    <height>115</height>
                    <aspectratio>keep</aspectratio>
                    <texture>$INFO[Window.Property(channelicon)]</texture>
                </control>

                <control type="textbox">
                    <visible>String.IsEmpty(Window.Property(channelicon))</visible>
                    <top>0</top>
                    <right>0</right>
                    <width>190</width>
                    <height>115</height>
                    <font>light40</font>
                    <align>center</align>
                    <aligny>center</aligny>
                    <textcolor>active</textcolor>
                    <shadowcolor>black</shadowcolor>
                    <label>$INFO[Window.Property(channel)]</label>
                </control>

                <!-- metadata row -->
                <control type="image">
                    <top>165</top>
                    <left>0</left>
                    <width>1185</width>
                    <height>1</height>
                    <texture colordiffuse="border">colors/white.png</texture>
                </control>

                <control type="grouplist">
                    <top>190</top>
                    <left>0</left>
                    <width>550</width>
                    <height>90</height>
                    <orientation>vertical</orientation>
                    <itemgap>13</itemgap>
                    <usecontrolcoords>true</usecontrolcoords>

                    <control type="label">
                        <height>34</height>
                        <font>regular30</font>
                        <textcolor>white</textcolor>
                        <label>[COLOR active]$LOCALIZE[552][/COLOR]  $INFO[Window.Property(datelong)]</label>
                    </control>
                    <control type="label">
                        <height>34</height>
                        <font>regular30</font>
                        <textcolor>white</textcolor>
                        <label>[COLOR active]$LOCALIZE[555][/COLOR]  $INFO[Window.Property(starttime)] - $INFO[Window.Property(endtime)]</label>
                    </control>
                </control>

                <control type="grouplist">
                    <top>190</top>
                    <left>590</left>
                    <width>560</width>
                    <height>90</height>
                    <orientation>vertical</orientation>
                    <itemgap>13</itemgap>
                    <usecontrolcoords>true</usecontrolcoords>

                    <control type="label">
                        <visible>!String.IsEmpty(Window.Property(genre))</visible>
                        <height>34</height>
                        <font>regular30</font>
                        <textcolor>white</textcolor>
                        <label>[COLOR active]$LOCALIZE[515][/COLOR]  $INFO[Window.Property(genre)]</label>
                    </control>
                    <control type="label">
                        <visible>!String.IsEmpty(Window.Property(year)) + !String.IsEqual(Window.Property(year),0)</visible>
                        <height>34</height>
                        <font>regular30</font>
                        <textcolor>white</textcolor>
                        <label>[COLOR active]$LOCALIZE[562][/COLOR]  $INFO[Window.Property(year)]</label>
                    </control>
                    <control type="label">
                        <visible>!String.IsEmpty(Window.Property(director))</visible>
                        <height>34</height>
                        <font>regular30</font>
                        <textcolor>white</textcolor>
                        <label>[COLOR active]$LOCALIZE[20339][/COLOR]  $INFO[Window.Property(director)]</label>
                    </control>
                </control>

                <!-- plot -->
                <control type="textbox" id="100">
                    <pagecontrol>100001</pagecontrol>
                    <top>310</top>
                    <left>0</left>
                    <width>1145</width>
                    <height>420</height>
                    <font>regular30</font>
                    <textcolor>white</textcolor>
                    <scrolltime>200</scrolltime>
                    <label>$INFO[Window.Property(plot)]</label>
                </control>

                <control type="scrollbar" id="100001">
                    <top>310</top>
                    <left>1160</left>
                    <width>15</width>
                    <height>420</height>
                    <orientation>vertical</orientation>
                    <onleft>101</onleft>
                    <onright>101</onright>
                    <texturesliderbackground colordiffuse="border" border="3">progress/texturebg_border_white.png</texturesliderbackground>
                    <texturesliderbar colordiffuse="white" border="3,6,3,6">progress/texturebg_white.png</texturesliderbar>
                    <texturesliderbarfocus colordiffuse="active" border="3,6,3,6">progress/texturebg_white.png</texturesliderbarfocus>
                </control>
            </control>

            <!-- bottom separator -->
            <control type="image">
                <top>795</top>
                <left>30</left>
                <width>1655</width>
                <height>1</height>
                <texture colordiffuse="border">colors/white.png</texture>
            </control>

            <!-- TEST: progress bar under bottom separator -->
			<!-- <control type="progress" id="601">
				<visible>String.IsEqual(Window.Property(showprogress),true)</visible>
				<left>30</left>
				<top>810</top>
				<width>420</width>
				<height>12</height>
				<texturebg border="3">progress/texturebg_border_white.png</texturebg>
				<midtexture colordiffuse="active" border="5,3,5,3">progress/texturebg_white.png</midtexture>
			</control>

			<control type="label">
				<visible>String.IsEqual(Window.Property(showprogress),true)</visible>
				<left>30</left>
				<top>825</top>
				<width>420</width>
				<height>30</height>
				<font>regular24</font>
				<textcolor>white</textcolor>
				<label>Progress: $INFO[Window.Property(progresspercentage)]%</label>
			</control> -->

            <!-- close button - original round style -->
            <control type="grouplist" id="101">
                <bottom>-40</bottom>
                <right>20</right>
                <align>right</align>
                <height>100</height>
                <orientation>horizontal</orientation>
                <itemgap>5</itemgap>
                <usecontrolcoords>true</usecontrolcoords>
                <defaultcontrol always="true">102</defaultcontrol>
                <onup>100001</onup>
                <include content="button_round">
                    <param name="id">102</param>
                    <param name="onclick">Back</param>
                    <param name="icon">icons/buttons/close.png</param>
                    <param name="radius">100</param>
                    <param name="iconsize">60</param>
                    <param name="iconoffset">20</param>
                </include>
            </control>
        </control>
    </controls>
</window>
